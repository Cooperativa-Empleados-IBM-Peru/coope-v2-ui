FROM registry.redhat.io/ubi9/nginx-122:latest

# UBI images may already default to a non-root user; switch to root
# only for the steps that require write access to system paths.
USER root
RUN dnf upgrade -y && dnf clean all

COPY . /usr/share/nginx/html/
RUN sed -i 's/listen\s*80;/listen 8080;/' /etc/nginx/conf.d/nginx.conf \
    && chown -R 1001:0 /usr/share/nginx/html \
    && chmod -R g=u /usr/share/nginx/html

# Drop back to the non-root nginx user (uid 1001) shipped by ubi9/nginx-122
USER 1001
EXPOSE 8080
